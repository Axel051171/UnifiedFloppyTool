#!/usr/bin/env bash
# UFT pre-push hook — catches the bug class that produced the
# 4-CI-annotation whack-a-mole session of 2026-04-26.
#
# Install: bash scripts/install-hooks.sh
# Bypass:  git push --no-verify   (avoid; CI catches the same things)
#
# Runs three fast checks (~15 s total):
#   1. Build-system parity (verify_build_sources.py)
#   2. Consistency check  (check_consistency.py — dangling #include,
#      missing target_sources, undefined TEST_LIBS targets)
#   3. CMake configure smoke (catches dangling lib targets at configure
#      time, not link time, via CMAKE_LINK_LIBRARIES_ONLY_TARGETS=ON)
#
# ── MF-925: EINE PRUEFUNG, DIE SICH SELBST UEBERSPRINGT, IST KEINE ───
#
# Bis MF-925 endete Pruefung 3 ohne Compiler so:
#
#     WARN: CMake configure could not find a C/C++ compiler — skipping
#           ... CI gates the same thing, so this is non-blocking.
#     ==> checks 1+2 passed (3 skipped) — push allowed
#     exit 0
#
# Der Satz ist sachlich richtig — CI prueft dasselbe. Trotzdem war es
# dieselbe Klasse, die dieser Baum sonst ueberall jagt: ein Pruefwerkzeug,
# das seine eigene Pruefung nicht ausfuehrt und danach FREIGIBT. Die
# Zeile "checks 1+2 passed (3 skipped)" liest sich im Vorbeigehen wie
# "3 passed" — und genau das ist auf dieser Maschine ueber Monate
# passiert, ohne dass die dritte Pruefung je gelaufen waere.
#
# Zwei Aenderungen:
#
#   a) Der Haken SUCHT die Werkzeugkette, statt sich auf den PATH zu
#      verlassen. MinGW liegt hier unter C:/Qt/Tools/mingw*/bin und war
#      nie im PATH der Haken-Umgebung. Gesucht wird per Muster, nicht
#      mit einem gepflegten Pfad — ein fester Pfad waere beim naechsten
#      Qt-Update wieder falsch, und wieder still.
#   b) Findet er trotzdem keinen, ist das ein FEHLSCHLAG, kein Hinweis.
#      Wer wirklich keine Werkzeugkette hat, setzt
#      UFT_PREPUSH_ALLOW_NO_COMPILER=1 — dann steht die Freigabe da,
#      aber als bewusste Entscheidung mit Namen, nicht als Nebensatz.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "==> [1/3] verify_build_sources.py …"
python3 scripts/verify_build_sources.py >/dev/null

echo "==> [2/3] check_consistency.py …"
python3 scripts/check_consistency.py

echo "==> [3/3] CMake configure smoke …"

# ── MF-925: Werkzeugkette suchen, nicht voraussetzen ─────────────────
# Erst der PATH, dann die Orte, an denen auf dieser Plattform ueblich
# etwas liegt. Alles per Muster (glob), damit ein Versionswechsel den
# Haken nicht stumm macht.
if ! command -v cc >/dev/null 2>&1 && \
   ! command -v gcc >/dev/null 2>&1 && \
   ! command -v clang >/dev/null 2>&1 && \
   ! command -v cl >/dev/null 2>&1; then
    for cand in /c/Qt/Tools/mingw*/bin /c/msys64/mingw64/bin \
                /c/MinGW/bin "/c/Program Files/LLVM/bin"; do
        if [[ -x "$cand/gcc.exe" || -x "$cand/clang.exe" ]]; then
            PATH="$cand:$PATH"
            export PATH
            echo "     (Werkzeugkette gefunden: $cand)"
            break
        fi
    done
fi

# ── MF-925: Qt6 ebenso suchen ────────────────────────────────────────
# Der fehlende Compiler hat eine ZWEITE Voraussetzung verdeckt:
# CMakeLists.txt:99 ruft `find_package(Qt6 ...)`. Ohne Qt6 im
# CMAKE_PREFIX_PATH bricht die Konfiguration ab — und zwar mit einer
# ANDEREN Meldung als beim fehlenden Compiler, also nicht im
# Skip-Zweig, sondern als echter Fehlschlag.
#
# Gemessen beim Bau dieses Fixes: nachdem die Werkzeugkette gefunden
# war, scheiterte der Lauf genau daran. Haette ich nur (a) und (b)
# gemacht, wuerde der Haken ab sofort JEDEN Push auf dieser Maschine
# blockieren — die Reparatur waere schlimmer gewesen als der Fehler.
#
# Auch hier per Muster statt gepflegtem Pfad.
UFT_QT_PREFIX_ARG=()
if [[ -z "${CMAKE_PREFIX_PATH:-}" ]]; then
    for qt in /c/Qt/*/mingw_64 /c/Qt/*/msvc*_64 /usr/lib/qt6 /opt/qt6; do
        if [[ -d "$qt/lib/cmake/Qt6" ]]; then
            UFT_QT_PREFIX_ARG=(-DCMAKE_PREFIX_PATH="$qt")
            echo "     (Qt6 gefunden: $qt)"
            break
        fi
    done
fi

TMP="$(mktemp -d -t uft-cmake-prepush-XXXXXX)"
trap 'rm -rf "$TMP"' EXIT

# Pick a generator that matches available toolchains. CMake on Windows
# defaults to "Visual Studio 17 2022" which fails on MinGW-only boxes
# and on POSIX shells in general. Detect the dev environment.
CMAKE_GEN_ARG=()
if command -v ninja >/dev/null 2>&1; then
    CMAKE_GEN_ARG=(-G Ninja)
elif command -v mingw32-make >/dev/null 2>&1; then
    CMAKE_GEN_ARG=(-G "MinGW Makefiles")
fi  # else: let cmake pick its platform default (Unix Makefiles on POSIX)

if cmake "${CMAKE_GEN_ARG[@]}" "${UFT_QT_PREFIX_ARG[@]}" \
        -B "$TMP" -DUFT_BUILD_TESTS=ON \
        >"$TMP/configure.log" 2>&1; then
    echo "==> all 3 checks passed — push allowed"
    exit 0
fi

# Configure failed. Distinguish "no compiler" (environment issue) from
# real CMake errors (e.g. dangling target, parse error in CMakeLists).
if grep -qE "No CMAKE_(C|CXX)_COMPILER could be found" "$TMP/configure.log"; then
    if [[ -n "${UFT_PREPUSH_ALLOW_NO_COMPILER:-}" ]]; then
        echo
        echo "==> [3/3] NICHT GELAUFEN — keine Werkzeugkette gefunden."
        echo "    Freigabe nur wegen UFT_PREPUSH_ALLOW_NO_COMPILER=1."
        echo "    Diese Pruefung hat NICHT stattgefunden; CI prueft"
        echo "    dasselbe, aber erst nach dem Push."
        echo "==> 2 von 3 Pruefungen gelaufen — push erlaubt (bewusst)"
        exit 0
    fi
    echo
    echo "FAIL: [3/3] konnte nicht laufen — keine C/C++-Werkzeugkette gefunden."
    echo
    echo "  Gesucht wurde im PATH (cc/gcc/clang/cl) und unter:"
    echo "    /c/Qt/Tools/mingw*/bin  /c/msys64/mingw64/bin"
    echo "    /c/MinGW/bin            'C:/Program Files/LLVM/bin'"
    echo
    echo "  MF-925: frueher gab der Haken hier mit einem Hinweis FREI."
    echo "  Das las sich wie '3 passed' und war 'nie gelaufen'. Eine"
    echo "  Pruefung, die sich selbst ueberspringt, ist keine."
    echo
    echo "  Zwei Auswege:"
    echo "    - Werkzeugkette bereitstellen (MinGW + Ninja, oder VS-Prompt)"
    echo "    - bewusst ohne: UFT_PREPUSH_ALLOW_NO_COMPILER=1 git push"
    exit 1
fi

echo
echo "FAIL: cmake -B <tmp> -DUFT_BUILD_TESTS=ON failed (not a compiler issue)."
echo "Last lines of configure log:"
tail -20 "$TMP/configure.log" | sed 's/^/    /'
echo
echo "Reproduce locally with:"
echo "    cmake -B build-tests -DUFT_BUILD_TESTS=ON"
exit 1
