#!/usr/bin/env bash
# UFT pre-commit hook — Type-Driven HAL refactor (refactor/type-driven-hal)
#
# Install once with:
#   cp scripts/git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Block commits that:
#   1. break the build (cmake or qmake — whichever build dir exists)
#   2. break the foundation contract (test_hal_foundation must pass)
#   3. introduce build-source-parity regressions
#   4. introduce SSOT drift (version, error-codes, etc.)
#
# This hook is fast: only foundation + parity checks. Full ctest is the
# CI's job, not the developer's per-commit gate.
#
# Bypass policy: use --no-verify ONLY when explicitly approved on a
# WIP/STOP-condition commit. Otherwise: fix, re-stage, retry.

set -e

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

CURRENT_BRANCH="$(git rev-parse --abbrev-ref HEAD)"
echo "[pre-commit] branch: $CURRENT_BRANCH"

# ── Baumsperre (MF-1096, Sperre 2) ──────────────────────────────────────
#
# Dieser Haken laeuft Minuten, und nichts im Baum zeigt an, dass er
# laeuft. Drei Commits in Folge sind daran gescheitert, dass waehrend
# dieser Zeit `gen_stand.py` bzw. `gen_verification_tiers.py` die
# abgeleiteten Dokumente NEU geschrieben haben: der Haken vergleicht sie
# mit ihren Quellen und meldete `[STAND.md stale]` — einen Zustand, den
# erst die Messung selbst erzeugt hat (Klasse MF-1043).
#
# Die Sperre ist eine Datei, die Generatoren vor ihrem Schreibvorgang
# abfragen (`scripts/commit_lock.py`). `UFT_COMMIT_HOOK` erbt jeder
# Prozess, den DIESER Haken startet — sonst wuerde die Sperre den Commit
# blockieren, den sie schuetzt.
#
# Grenze, benannt statt verschwiegen: der `trap` feuert, wenn der HAKEN
# endet, nicht wenn `git commit` endet. Die Sekunde danach (commit-msg,
# Schreiben des Commit-Objekts) ist ungedeckt; die teure Strecke ist es
# nicht.
GIT_DIR_ABS="$(git rev-parse --absolute-git-dir)"
COMMIT_LOCK="$GIT_DIR_ABS/uft-commit.lock"
trap 'rm -f "$COMMIT_LOCK"' EXIT
{
    echo "pid $$"
    echo "zweig $CURRENT_BRANCH"
    echo "seit $(date -u +%Y-%m-%dT%H:%M:%SZ)"
} > "$COMMIT_LOCK"
export UFT_COMMIT_HOOK=1

# ── Gate 1: consistency + parity ────────────────────────────────────────
echo "[pre-commit] check_consistency.py..."
if ! python3 scripts/check_consistency.py >/tmp/uft-consistency.log 2>&1; then
    echo "  FAIL — see /tmp/uft-consistency.log"
    cat /tmp/uft-consistency.log
    exit 1
fi
echo "  ok"

echo "[pre-commit] verify_build_sources.py..."
if ! python3 scripts/verify_build_sources.py >/tmp/uft-parity.log 2>&1; then
    echo "  FAIL — see /tmp/uft-parity.log"
    cat /tmp/uft-parity.log
    exit 1
fi
echo "  ok"

# ── Gate 1b: CMake muss AUSWERTBAR sein, und eine Quelle darf nicht fehlen
#
# MF-773. Der Kopf dieses Hooks sagt seit jeher, er blockiere „commits that
# break the build" — und er hat nie gebaut. Was das kostete, ist gemessen:
# MF-765 fuehrte `uft_track_verdikt.c` als Abhaengigkeit des Flussdekoders
# ein, MF-768 `uft_amiga_syncs.c`, MF-766 ueber UFT_WARN das `uft_log.c`.
# Eingetragen waren sie nur in den NEUEN Testzielen; in 43 weiteren
# Bloecken fehlten sie. Dazu lagen zwei Quellzeilen AUSSERHALB eines
# `target_sources`-Blocks — `tests/CMakeLists.txt` liess sich gar nicht
# mehr auswerten. Vier Commits lang fiel das niemandem auf, weil weder
# check_consistency.py noch verify_build_sources.py noch dieser Hook baut.
#
# Zwei Stufen, beide billig:
#   (a) `cmake` neu auswerten — Sekunden, faengt jede kaputte CMakeLists
#   (b) EINEN Kanarientest bauen — faengt fehlende Quellen im Linkschritt
#
# Stufe (b) laeuft nur, wenn das Build-Verzeichnis schon steht; ein
# Erstbau gehoert nicht in einen Commit-Hook. Wer beides ueberspringt,
# verlaesst sich auf CI — das ist erlaubt und wird gesagt, nicht
# verschwiegen.
CMAKE_TOUCHED="$(git diff --cached --name-only | grep -cE 'CMakeLists\.txt$|\.cmake$' || true)"
if [ "$CMAKE_TOUCHED" -gt 0 ]; then
    if ! command -v cmake >/dev/null 2>&1; then
        echo "[pre-commit] cmake-Auswertung: skip (kein cmake in PATH)"
        echo "  CI faengt dasselbe; dieses Tor ist eine Bequemlichkeit."
    else
        # ── MF-1118: gemessen statt aufgezaehlt (MF-636) ─────────────
        #
        # Hier stand `for d in build build-cxx20`. Das ist eine
        # gepflegte Liste, und sie war schon veraltet: das
        # Build-Verzeichnis dieser Maschine UND der Testlaeufe heisst
        # `build-tests-ci` und stand nicht darin. Gesucht wird jetzt
        # nach dem MERKMAL — eine `CMakeCache.txt` unter einem
        # `build*`-Verzeichnis —, damit ein neuer Name den Haken nicht
        # stumm macht. Sechzehnter Fall von Aufzaehlung statt Messung.
        BUILD_DIR=""
        for d in build*/; do
            d="${d%/}"
            [ -f "$d/CMakeCache.txt" ] && { BUILD_DIR="$d"; break; }
        done
        if [ -z "$BUILD_DIR" ]; then
            echo "[pre-commit] cmake-Auswertung: skip (kein konfiguriertes Build-Verzeichnis)"
        else
            echo "[pre-commit] cmake auswerten ($BUILD_DIR)..."
            if ! cmake -S . -B "$BUILD_DIR" >/tmp/uft-cmake.log 2>&1; then
                echo "  FAIL — CMakeLists nicht auswertbar. Auszug:"
                grep -iE "error|Parse error" /tmp/uft-cmake.log | head -5
                echo "  voll: /tmp/uft-cmake.log"
                exit 1
            fi
            echo "  ok"

            # Kanarientest: ein kleines Ziel, das den Flussdekoder linkt —
            # genau die Stelle, an der die fehlenden Quellen auffielen.
            #
            # Die Bedingung sucht die Kernbibliothek IRGENDWO im
            # Build-Baum. Eine erste Fassung prueft `$BUILD_DIR/libuft_core.a`
            # — dort liegt sie nicht (sondern unter `src/core/`), und das
            # Tor uebersprang deshalb still. Ein Tor, das lautlos nichts
            # tut, ist genau der Fehler, den dieses Tor behebt; deshalb
            # steht der Fall hier und nicht nur im Commit.
            CANARY="test_flux_nosync_split"
            if find "$BUILD_DIR" -name 'libuft_core.a' -o -name 'uft_core.lib' \
                 2>/dev/null | grep -q .; then
                echo "[pre-commit] Kanarientest bauen ($CANARY)..."
                if ! cmake --build "$BUILD_DIR" --target "$CANARY" \
                        >/tmp/uft-canary.log 2>&1; then
                    echo "  FAIL — fehlende Quelle oder Linkfehler. Auszug:"
                    grep -iE "undefined reference|error:" /tmp/uft-canary.log \
                        | sort -u | head -5
                    echo "  voll: /tmp/uft-canary.log"
                    exit 1
                fi
                echo "  ok"
            else
                echo "[pre-commit] Kanarientest: skip (uft_core noch nicht gebaut)"
                echo "  Ein Erstbau gehoert nicht in einen Commit-Hook; CI baut."
            fi
        fi
    fi
fi

# ── Gate 2: foundation compile-test (refactor branches only) ────────────
case "$CURRENT_BRANCH" in
    refactor/*|main)
        if [ -f tests/test_hal_foundation.cpp ]; then
            CXX="${CXX:-g++}"

            # ── MF-1118: dieselbe Behandlung wie in pre-push (MF-925) ────
            #
            # Der Kopf dieses Hakens verspricht woertlich „2. break the
            # foundation contract (test_hal_foundation must pass)". Auf
            # dieser Maschine hat er das Versprechen nicht gehalten: er
            # meldete `skip (no g++ in PATH)` und gab frei. MinGW liegt
            # unter /c/Qt/Tools/mingw*/bin und war nie im PATH der
            # Haken-Umgebung.
            #
            # Und die Pruefung war dabei nicht unerfuellbar, sondern nur
            # ABWESEND — gemessen mit der Werkzeugkette im Pfad:
            # uebersetzt ohne Warnung und meldet „test_hal_foundation:
            # 0 errors, foundation sound".
            #
            # MF-925 hat genau das fuer `pre-push` behoben, und sein
            # Kopf sagt es selbst: „genau das ist auf dieser Maschine
            # ueber Monate passiert, ohne dass die dritte Pruefung je
            # gelaufen waere." Die NACHBARDATEI wurde uebersehen — die
            # Gestalt von MF-519/MF-529, in diesem Baum der wiederkehrende
            # Fall „eine Stelle geholt, die andere stehen gelassen".
            #
            # Gesucht wird per Muster, nicht mit einem gepflegten Pfad:
            # ein fester Pfad waere beim naechsten Qt-Update wieder
            # falsch, und wieder still.
            if ! command -v "$CXX" >/dev/null 2>&1; then
                for cand in /c/Qt/Tools/mingw*/bin /c/msys64/mingw64/bin \
                            /c/MinGW/bin "/c/Program Files/LLVM/bin"; do
                    if [ -x "$cand/g++.exe" ] || [ -x "$cand/clang++.exe" ]; then
                        PATH="$cand:$PATH"
                        export PATH
                        echo "[pre-commit] Werkzeugkette gefunden: $cand"
                        break
                    fi
                done
            fi

            if ! command -v "$CXX" >/dev/null 2>&1; then
                # Findet er trotzdem keine, ist das ein FEHLSCHLAG, kein
                # Hinweis. Wer wirklich keine Werkzeugkette hat, setzt
                # UFT_PRECOMMIT_ALLOW_NO_COMPILER=1 — dann steht die
                # Freigabe da, aber als bewusste Entscheidung MIT NAMEN,
                # nicht als Nebensatz, der sich wie „ok" liest.
                if [ "${UFT_PRECOMMIT_ALLOW_NO_COMPILER:-0}" = "1" ]; then
                    echo "[pre-commit] test_hal_foundation: NICHT GELAUFEN"
                    echo "  UFT_PRECOMMIT_ALLOW_NO_COMPILER=1 ist gesetzt —"
                    echo "  Freigabe auf ausdrueckliche Entscheidung."
                else
                    echo "[pre-commit] test_hal_foundation: FAIL — keine"
                    echo "  C++-Werkzeugkette gefunden ($CXX nicht im PATH,"
                    echo "  und /c/Qt/Tools/mingw*/bin, /c/msys64/mingw64/bin,"
                    echo "  /c/MinGW/bin, /c/Program Files/LLVM/bin tragen"
                    echo "  weder g++.exe noch clang++.exe)."
                    echo "  Der Kopf dieses Hakens sagt: test_hal_foundation"
                    echo "  MUSS bestehen. Ein stiller Skip waere eine"
                    echo "  Freigabe ohne Pruefung (MF-1118)."
                    echo "  Ausweg mit Namen: UFT_PRECOMMIT_ALLOW_NO_COMPILER=1"
                    exit 1
                fi
            else
                echo "[pre-commit] test_hal_foundation compile + run..."
                CC="${CC:-gcc}"
                INC="-I include"
                tmpbin="$(mktemp -t uft_h9_XXXXXX).exe"
                if ! "$CXX" -std=c++20 -Wall -Wextra $INC \
                        tests/test_hal_foundation.cpp -o "$tmpbin" \
                        > /tmp/uft-foundation.log 2>&1; then
                    echo "  FAIL — see /tmp/uft-foundation.log"
                    cat /tmp/uft-foundation.log
                    rm -f "$tmpbin"
                    exit 1
                fi
                if ! "$tmpbin" > /tmp/uft-foundation-run.log 2>&1; then
                    echo "  FAIL (runtime) — see /tmp/uft-foundation-run.log"
                    cat /tmp/uft-foundation-run.log
                    rm -f "$tmpbin"
                    exit 1
                fi
                rm -f "$tmpbin"
                echo "  ok"
            fi
        fi
        ;;
esac

# ── Gate 3: protected paths (warn-only on main, refuse on refactor branch)
PROTECTED_PATHS=(
    "src/hal/uft_greaseweazle_full.c"
    "tests/golden/"
    "docs/DESIGN_PRINCIPLES.md"
)
case "$CURRENT_BRANCH" in
    refactor/type-driven-hal)
        # Foundation headers protected during P1
        PROTECTED_PATHS+=(
            "include/uft/hal/outcomes.h"
            "include/uft/hal/concepts.h"
            "include/uft/hal/mixins.h"
        )
        ;;
esac

for path in "${PROTECTED_PATHS[@]}"; do
    if git diff --cached --name-only | grep -qE "^${path}"; then
        echo "[pre-commit] WARNING: commit touches protected path: $path"
        echo "  Override only if this is an architecture-level change with"
        echo "  human review. Otherwise: unstage and ask."
        # Warn but don't block — judgment call is the human's.
    fi
done

echo "[pre-commit] all gates green"
exit 0
