      <!-- GCR / NIBBLE -->
      <item>
       <widget class="QGroupBox" name="groupNibble">
        <property name="minimumSize"><size><width>0</width><height>100</height></size></property>
        <property name="title"><string>GCR / Nibble</string></property>
        <layout class="QVBoxLayout">
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>Type:</string></property></widget></item>
