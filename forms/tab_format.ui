<?xml version="1.0" encoding="UTF-8"?>
<!--
  Settings tab of UnifiedFloppyTool (MF-1618).

  Based on the owner's Qt Designer draft "settings_redesign.ui" (2026-09-29)
  and the four owner answers of the same day:
    1. the copy-plan axes are their own section, editable only in the mode
       "Benutzerdefiniert"; findings always visible in the help column;
    2. fields whose value reaches no operation stay visible, disabled, and
       marked "noch nicht verdrahtet" (formattab.cpp sets that, not this file);
    3. a tab that takes effect immediately: no Apply / Close buttons;
    4. only this tab is replaced.
  Object names follow the old form where the meaning is the same
  (btnModus_*, comboPlan*, comboSystem/Format/Version, spinRevolutions,
  checkSHA256/checkHashSha512/checkCRC32, labelProfileText, labelPlan*),
  so the checked logic in formattab.cpp keeps its anchors.
-->
<ui version="4.0">
 <class>TabFormat</class>
 <widget class="QWidget" name="TabFormat">
  <property name="geometry"><rect><x>0</x><y>0</y><width>1500</width><height>900</height></rect></property>
  <property name="windowTitle"><string>Einstellungen</string></property>
  <layout class="QVBoxLayout" name="rootLayout">
   <property name="leftMargin"><number>8</number></property>
   <property name="topMargin"><number>8</number></property>
   <property name="rightMargin"><number>8</number></property>
   <property name="bottomMargin"><number>8</number></property>
   <property name="spacing"><number>6</number></property>

   <item>
    <widget class="QFrame" name="frameStatus">
     <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
     <layout class="QHBoxLayout" name="statusLayout">
      <property name="leftMargin"><number>8</number></property>
      <property name="topMargin"><number>5</number></property>
      <property name="rightMargin"><number>8</number></property>
      <property name="bottomMargin"><number>5</number></property>
      <item><widget class="QLabel" name="labelSettingsTitle"><property name="text"><string>&lt;b&gt;Kopiermodus und Einstellungen&lt;/b&gt;</string></property></widget></item>
      <item><spacer name="statusSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>40</width><height>20</height></size></property></spacer></item>
      <item><widget class="QLabel" name="labelHardwareStatus"><property name="text"><string>● Keine Hardware verbunden</string></property><property name="toolTip"><string>Verbundene Hardware und ihr Zustand, wie der Reiter „Hardware“ ihn meldet.</string></property></widget></item>
     </layout>
    </widget>
   </item>

   <item>
    <layout class="QHBoxLayout" name="contentLayout" stretch="4,1">
     <property name="spacing"><number>8</number></property>

     <item>
      <widget class="QScrollArea" name="scrollSettings">
       <property name="widgetResizable"><bool>true</bool></property>
       <widget class="QWidget" name="scrollSettingsContents">
        <layout class="QVBoxLayout" name="settingsLayout">
         <property name="leftMargin"><number>4</number></property>
         <property name="topMargin"><number>4</number></property>
         <property name="rightMargin"><number>4</number></property>
         <property name="bottomMargin"><number>4</number></property>
         <property name="spacing"><number>6</number></property>

         <item>
          <widget class="QGroupBox" name="groupCopyMode">
           <property name="title"><string>1. Kopiermodus</string></property>
           <property name="toolTip"><string>Der Kopiermodus ist der Ausgangspunkt. Er setzt den Kopierplan; alle folgenden Einstellungen richten sich danach.</string></property>
           <layout class="QVBoxLayout" name="copyModeOuterLayout">
            <item>
             <widget class="QLabel" name="labelModeIntro"><property name="text"><string>Wählen Sie zuerst, wie die Diskette verarbeitet werden soll. Einstellungen, die der Modus oder das Format nicht verwenden, werden danach ausgeblendet.</string></property><property name="wordWrap"><bool>true</bool></property></widget>
            </item>
            <item>
             <layout class="QGridLayout" name="copyModeGrid">
              <property name="horizontalSpacing"><number>5</number></property><property name="verticalSpacing"><number>5</number></property>
              <item row="0" column="0"><widget class="QPushButton" name="btnModus_standardcopy"><property name="text"><string>Standardkopie</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="0" column="1"><widget class="QPushButton" name="btnModus_fluxcopy"><property name="text"><string>FluxCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="0" column="2"><widget class="QPushButton" name="btnModus_doscopy"><property name="text"><string>DOSCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="0" column="3"><widget class="QPushButton" name="btnModus_deepcopy"><property name="text"><string>DeepCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="1" column="0"><widget class="QPushButton" name="btnModus_bamcopy"><property name="text"><string>BAMCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="1" column="1"><widget class="QPushButton" name="btnModus_consensuscopy"><property name="text"><string>ConsensusCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="1" column="2"><widget class="QPushButton" name="btnModus_fastcopy"><property name="text"><string>FastCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="1" column="3"><widget class="QPushButton" name="btnModus_cyclone"><property name="text"><string>Cyclone</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="2" column="0"><widget class="QPushButton" name="btnModus_sectorcopy"><property name="text"><string>SectorCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="2" column="1"><widget class="QPushButton" name="btnModus_protectedcopy"><property name="text"><string>ProtectedCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="2" column="2"><widget class="QPushButton" name="btnModus_trackcopy"><property name="text"><string>TrackCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="2" column="3"><widget class="QPushButton" name="btnModus_bitexact"><property name="text"><string>Bittreu</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="3" column="0"><widget class="QPushButton" name="btnModus_spurlese"><property name="text"><string>Spurlese</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="3" column="1"><widget class="QPushButton" name="btnModus_salvage"><property name="text"><string>Datenrettung</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="3" column="2"><widget class="QPushButton" name="btnModus_rawcopy"><property name="text"><string>RawCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="3" column="3"><widget class="QPushButton" name="btnModus_evidence"><property name="text"><string>EvidenceCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="4" column="0"><widget class="QPushButton" name="btnModus_nibblecopy"><property name="text"><string>NibbleCopy</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item row="4" column="1"><widget class="QPushButton" name="btnModus_custom"><property name="text"><string>Benutzerdefiniert</string></property><property name="checkable"><bool>true</bool></property></widget></item>
             </layout>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupCopyPlan">
           <property name="title"><string>Kopierplan</string></property>
           <property name="toolTip"><string>Die Achsen des Kopierplans. Der Kopiermodus setzt sie; frei einstellbar sind sie nur im Modus „Benutzerdefiniert“.</string></property>
           <layout class="QGridLayout" name="copyPlanGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelPlanLevel"><property name="text"><string>Ebene:</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="comboPlanLevel"><property name="toolTip"><string>Parameter: plan.level</string></property></widget></item>
            <item row="0" column="2"><widget class="QLabel" name="labelPlanStrategy"><property name="text"><string>Strategie:</string></property></widget></item>
            <item row="0" column="3"><widget class="QComboBox" name="comboPlanStrategy"><property name="toolTip"><string>Parameter: plan.strategy</string></property></widget></item>
            <item row="1" column="0"><widget class="QLabel" name="labelPlanPreserve"><property name="text"><string>Erhaltung:</string></property></widget></item>
            <item row="1" column="1"><widget class="QComboBox" name="comboPlanPreserve"><property name="toolTip"><string>Parameter: plan.preservation</string></property></widget></item>
            <item row="1" column="2"><widget class="QLabel" name="labelPlanPolicy"><property name="text"><string>Richtlinie:</string></property></widget></item>
            <item row="1" column="3"><widget class="QComboBox" name="comboPlanPolicy"><property name="toolTip"><string>Parameter: plan.policy</string></property></widget></item>
            <item row="2" column="0"><widget class="QLabel" name="labelPlanTrackMode"><property name="text"><string>Spurart:</string></property></widget></item>
            <item row="2" column="1"><widget class="QComboBox" name="comboPlanTrackMode"><property name="toolTip"><string>Parameter: plan.track_mode</string></property></widget></item>
            <item row="2" column="2"><widget class="QLabel" name="labelPlanFileSpecial"><property name="text"><string>Dateiart:</string></property></widget></item>
            <item row="2" column="3"><widget class="QComboBox" name="comboPlanFileSpecial"><property name="toolTip"><string>Parameter: plan.file_special</string></property></widget></item>
            <item row="3" column="0"><widget class="QLabel" name="labelPlanVote"><property name="text"><string>Abstimmung:</string></property></widget></item>
            <item row="3" column="1"><widget class="QComboBox" name="comboPlanVote"><property name="toolTip"><string>Parameter: plan.vote</string></property></widget></item>
            <item row="3" column="2"><widget class="QLabel" name="labelPlanExact"><property name="text"><string>Genauigkeit:</string></property></widget></item>
            <item row="3" column="3"><widget class="QComboBox" name="comboPlanExact"><property name="toolTip"><string>Parameter: plan.exact_kind</string></property></widget></item>
            <item row="4" column="0" colspan="4">
             <layout class="QHBoxLayout" name="rowPlanJson">
              <item><widget class="QPushButton" name="btnPlanJson"><property name="text"><string>Plan als JSON zeigen</string></property><property name="checkable"><bool>true</bool></property></widget></item>
              <item><widget class="QPushButton" name="btnPlanJsonKopieren"><property name="text"><string>In die Zwischenablage</string></property></widget></item>
              <item><widget class="QPushButton" name="btnPlanJsonSichern"><property name="text"><string>Sichern …</string></property></widget></item>
              <item><spacer name="planJsonSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
             </layout>
            </item>
            <item row="5" column="0" colspan="4"><widget class="QPlainTextEdit" name="textPlanJson"><property name="visible"><bool>false</bool></property><property name="readOnly"><bool>true</bool></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupFormat">
           <property name="title"><string>2. System und Format</string></property>
           <layout class="QGridLayout" name="formatGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelSystem"><property name="text"><string>System:</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="comboSystem"/></item>
            <item row="0" column="2"><widget class="QLabel" name="labelFormat"><property name="text"><string>Format:</string></property></widget></item>
            <item row="0" column="3"><widget class="QComboBox" name="comboFormat"/></item>
            <item row="0" column="4"><widget class="QLabel" name="labelVersion"><property name="text"><string>Variante:</string></property></widget></item>
            <item row="0" column="5"><widget class="QComboBox" name="comboVersion"/></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupReadDrive">
           <property name="title"><string>Lesen / Laufwerk</string></property>
           <layout class="QGridLayout" name="readDriveGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelEncoding"><property name="text"><string>Encoding:</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="comboEncoding"><item><property name="text"><string>Automatisch</string></property></item><item><property name="text"><string>FM</string></property></item><item><property name="text"><string>MFM</string></property></item><item><property name="text"><string>GCR</string></property></item></widget></item>
            <item row="0" column="2"><widget class="QLabel" name="labelRpm"><property name="text"><string>Drehzahl:</string></property></widget></item>
            <item row="0" column="3"><widget class="QComboBox" name="comboRpm"><item><property name="text"><string>Automatisch</string></property></item><item><property name="text"><string>300 RPM</string></property></item><item><property name="text"><string>360 RPM</string></property></item></widget></item>
            <item row="1" column="0"><widget class="QLabel" name="labelReadMode"><property name="text"><string>Lese-Modus:</string></property></widget></item>
            <item row="1" column="1"><widget class="QComboBox" name="comboReadMode"><item><property name="text"><string>Sicher</string></property></item><item><property name="text"><string>Normal</string></property></item><item><property name="text"><string>Schnell</string></property></item></widget></item>
            <item row="1" column="2"><widget class="QLabel" name="labelRevolutions"><property name="text"><string>Umdrehungen:</string></property></widget></item>
            <item row="1" column="3"><widget class="QSpinBox" name="spinRevolutions"><property name="minimum"><number>1</number></property><property name="maximum"><number>20</number></property><property name="value"><number>3</number></property></widget></item>
            <item row="2" column="0" colspan="2"><widget class="QCheckBox" name="checkReadBetweenIndex"><property name="text"><string>Zwischen Indeximpulsen lesen</string></property></widget></item>
            <item row="2" column="2" colspan="2"><widget class="QCheckBox" name="checkIncludeRawFlux"><property name="text"><string>Roh-Flux mitlesen</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupTrackSector">
           <property name="title"><string>Spur- und Sektoreinstellungen</string></property>
           <layout class="QGridLayout" name="trackSectorGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelTrackStart"><property name="text"><string>Start:</string></property></widget></item>
            <item row="0" column="1"><widget class="QSpinBox" name="spinTrackStart"><property name="maximum"><number>255</number></property></widget></item>
            <item row="0" column="2"><widget class="QLabel" name="labelTrackEnd"><property name="text"><string>Ende:</string></property></widget></item>
            <item row="0" column="3"><widget class="QSpinBox" name="spinTrackEnd"><property name="maximum"><number>255</number></property><property name="value"><number>79</number></property></widget></item>
            <item row="0" column="4"><widget class="QCheckBox" name="checkAllTracks"><property name="text"><string>Alle Spuren</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="1" column="0"><widget class="QLabel" name="labelSectorsPerTrack"><property name="text"><string>Sektoren/Spur:</string></property></widget></item>
            <item row="1" column="1"><widget class="QComboBox" name="comboSectorsPerTrack"><item><property name="text"><string>Automatisch</string></property></item></widget></item>
            <item row="1" column="2"><widget class="QLabel" name="labelInterleave"><property name="text"><string>Interleave:</string></property></widget></item>
            <item row="1" column="3"><widget class="QComboBox" name="comboInterleave"><item><property name="text"><string>Automatisch</string></property></item><item><property name="text"><string>Keins</string></property></item></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupPreservation">
           <property name="title"><string>Erhaltung / Schutzmerkmale</string></property>
           <layout class="QGridLayout" name="preserveGrid">
            <item row="0" column="0"><widget class="QCheckBox" name="checkPreserveTiming"><property name="text"><string>Originales Timing erhalten</string></property></widget></item>
            <item row="0" column="1"><widget class="QCheckBox" name="checkPreserveSync"><property name="text"><string>Sync-Marken erhalten</string></property></widget></item>
            <item row="1" column="0"><widget class="QCheckBox" name="checkWeakBits"><property name="text"><string>Schwache / mehrdeutige Bits erfassen</string></property></widget></item>
            <item row="1" column="1"><widget class="QCheckBox" name="checkDuplicateSectors"><property name="text"><string>Doppelte / Phantom-Sektoren erkennen</string></property></widget></item>
            <item row="2" column="0"><widget class="QCheckBox" name="checkProtectionSignals"><property name="text"><string>Schutzmerkmale erkennen</string></property></widget></item>
            <item row="2" column="1"><widget class="QCheckBox" name="checkSectorCountAnomalies"><property name="text"><string>Sektoranzahl-Anomalien erkennen</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupWrite">
           <property name="title"><string>Schreiben</string></property>
           <layout class="QGridLayout" name="writeGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelPrecomp"><property name="text"><string>Vorkompensation:</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="comboPrecomp"><item><property name="text"><string>Automatisch</string></property></item><item><property name="text"><string>Aus</string></property></item></widget></item>
            <item row="0" column="2"><widget class="QCheckBox" name="checkSplicePoint"><property name="text"><string>Splicepunkt schreiben</string></property></widget></item>
            <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="checkEraseOddTracks"><property name="text"><string>Ungerade Spuren löschen (48 auf 96 TPI)</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupErrorHandling">
           <property name="title"><string>Fehlerbehandlung</string></property>
           <layout class="QGridLayout" name="errorGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelErrors"><property name="text"><string>Fehler:</string></property></widget></item>
            <item row="0" column="1"><widget class="QComboBox" name="comboErrors"><item><property name="text"><string>Strikt</string></property></item><item><property name="text"><string>Warnen</string></property></item><item><property name="text"><string>Ignorieren</string></property></item></widget></item>
            <item row="0" column="2"><widget class="QLabel" name="labelMaxRetries"><property name="text"><string>Max. Wiederholungen:</string></property></widget></item>
            <item row="0" column="3"><widget class="QSpinBox" name="spinMaxRetries"><property name="maximum"><number>99</number></property><property name="value"><number>5</number></property></widget></item>
            <item row="1" column="0" colspan="2"><widget class="QCheckBox" name="checkRetryOnError"><property name="text"><string>Bei Fehler erneut lesen</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="1" column="2" colspan="2"><widget class="QCheckBox" name="checkSkipBadSectors"><property name="text"><string>Schlechte Sektoren überspringen</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupVerify">
           <property name="title"><string>Prüfen / Validieren</string></property>
           <layout class="QGridLayout" name="verifyGrid">
            <item row="0" column="0"><widget class="QCheckBox" name="checkVerify"><property name="text"><string>Nach dem Wandeln nachprüfen</string></property></widget></item>
            <item row="0" column="1"><widget class="QCheckBox" name="checkDiskStructure"><property name="text"><string>Disk-Struktur prüfen</string></property></widget></item>
            <item row="1" column="0"><widget class="QCheckBox" name="checkFilesystem"><property name="text"><string>Dateisystem prüfen</string></property></widget></item>
            <item row="1" column="1"><widget class="QCheckBox" name="checkAllocationMap"><property name="text"><string>Zuordnungstabelle prüfen</string></property></widget></item>
            <item row="2" column="0" colspan="2">
             <widget class="QWidget" name="unter_nachweis_Pruefsummen">
              <layout class="QHBoxLayout" name="hashLayout">
               <property name="leftMargin"><number>0</number></property>
               <property name="topMargin"><number>0</number></property>
               <property name="rightMargin"><number>0</number></property>
               <property name="bottomMargin"><number>0</number></property>
               <item><widget class="QLabel" name="labelHashes"><property name="text"><string>Prüfsummen (Beweissicherung):</string></property></widget></item>
               <item><widget class="QCheckBox" name="checkSHA256"><property name="text"><string>SHA-256</string></property><property name="checked"><bool>true</bool></property></widget></item>
               <item><widget class="QCheckBox" name="checkHashSha512"><property name="text"><string>SHA-512</string></property></widget></item>
               <item><widget class="QCheckBox" name="checkCRC32"><property name="text"><string>CRC32</string></property></widget></item>
               <item><spacer name="hashSpacer"><property name="orientation"><enum>Qt::Horizontal</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>10</height></size></property></spacer></item>
              </layout>
             </widget>
            </item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupExternal">
           <property name="title"><string>IPF- und CT-Raw-Abbilder</string></property>
           <property name="toolTip"><string>IPF- und CT-Raw-Abbilder können über die SPS-Bibliothek (CAPSImg) gelesen werden. Sie wird nicht mitgeliefert; tragen Sie hier ein, wo das Hilfsprogramm und die Bibliothek liegen.</string></property>
           <layout class="QGridLayout" name="externalGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelHelperPath"><property name="text"><string>Hilfsprogramm:</string></property></widget></item>
            <item row="0" column="1"><widget class="QLineEdit" name="editHelperPath"><property name="placeholderText"><string>uft_capsimg_helper (nicht eingerichtet)</string></property></widget></item>
            <item row="0" column="2"><widget class="QPushButton" name="btnHelperPath"><property name="text"><string>Suchen …</string></property></widget></item>
            <item row="1" column="0"><widget class="QLabel" name="labelCapsLibPath"><property name="text"><string>SPS-Bibliothek:</string></property></widget></item>
            <item row="1" column="1"><widget class="QLineEdit" name="editCapsLibPath"><property name="placeholderText"><string>CAPSImg.dll neben dem Hilfsprogramm</string></property></widget></item>
            <item row="1" column="2"><widget class="QPushButton" name="btnCapsLibPath"><property name="text"><string>Suchen …</string></property></widget></item>
            <item row="2" column="0" colspan="3"><widget class="QLabel" name="labelHelperStatus"><property name="wordWrap"><bool>true</bool></property></widget></item>
           </layout>
          </widget>
         </item>

         <item>
          <widget class="QGroupBox" name="groupAdvanced">
           <property name="title"><string>Erweiterte Optionen</string></property>
           <property name="checkable"><bool>true</bool></property>
           <property name="checked"><bool>false</bool></property>
           <layout class="QGridLayout" name="advancedGrid">
            <item row="0" column="0"><widget class="QLabel" name="labelClockAdjust"><property name="text"><string>Taktkorrektur:</string></property></widget></item>
            <item row="0" column="1"><widget class="QDoubleSpinBox" name="spinClockAdjust"><property name="minimum"><double>50.000000000000000</double></property><property name="maximum"><double>200.000000000000000</double></property><property name="value"><double>100.000000000000000</double></property><property name="suffix"><string> %</string></property></widget></item>
            <item row="0" column="2"><widget class="QCheckBox" name="checkAdaptivePll"><property name="text"><string>Adaptive Taktrückgewinnung</string></property><property name="checked"><bool>true</bool></property></widget></item>
            <item row="1" column="0"><widget class="QLabel" name="labelSyncTolerance"><property name="text"><string>Sync-Toleranz:</string></property></widget></item>
            <item row="1" column="1"><widget class="QDoubleSpinBox" name="spinSyncTolerance"><property name="maximum"><double>100.000000000000000</double></property><property name="value"><double>10.000000000000000</double></property><property name="suffix"><string> %</string></property></widget></item>
           </layout>
          </widget>
         </item>

         <item><spacer name="settingsBottomSpacer"><property name="orientation"><enum>Qt::Vertical</enum></property><property name="sizeHint" stdset="0"><size><width>20</width><height>40</height></size></property></spacer></item>
        </layout>
       </widget>
      </widget>
     </item>

     <item>
      <widget class="QFrame" name="frameHelp">
       <property name="minimumSize"><size><width>300</width><height>0</height></size></property>
       <property name="frameShape"><enum>QFrame::StyledPanel</enum></property>
