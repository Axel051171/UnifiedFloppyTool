 <class>TabFormat</class>
 <widget class="QWidget" name="TabFormat">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1000</width><height>700</height></rect>
  </property>
  <layout class="QHBoxLayout" name="mainLayout">
   <property name="spacing"><number>8</number></property>
   <property name="leftMargin"><number>4</number></property>
   <property name="topMargin"><number>4</number></property>
   <property name="rightMargin"><number>4</number></property>
   <property name="bottomMargin"><number>4</number></property>
   
   <!-- ═══════════════════ COLUMN 1 (33%) ═══════════════════ -->
   <item>
    <widget class="QWidget" name="col1Widget">
     <property name="sizePolicy">
      <sizepolicy hsizetype="Preferred" vsizetype="Preferred">
       <horstretch>1</horstretch>
       <verstretch>0</verstretch>
      </sizepolicy>
     </property>
     <layout class="QVBoxLayout" name="col1">
      <property name="spacing"><number>4</number></property>
      <property name="leftMargin"><number>0</number></property>
      <property name="topMargin"><number>0</number></property>
      <property name="rightMargin"><number>0</number></property>
      <property name="bottomMargin"><number>0</number></property>
      
      <!-- SYSTEM / FORMAT -->
      <item>
       <widget class="QGroupBox" name="groupSystem">
        <property name="minimumSize"><size><width>0</width><height>100</height></size></property>
        <property name="title"><string>System / Format</string></property>
        <layout class="QFormLayout">
         <item row="0" column="0"><widget class="QLabel"><property name="text"><string>System:</string></property></widget></item>
         <item row="0" column="1"><widget class="QComboBox" name="comboSystem"/></item>
         <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Format:</string></property></widget></item>
         <item row="1" column="1"><widget class="QComboBox" name="comboFormat"/></item>
         <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Version:</string></property></widget></item>
         <item row="2" column="1"><widget class="QComboBox" name="comboVersion"/></item>
        </layout>
       </widget>
      </item>
      
      <!-- FORMAT -->
      <item>
       <widget class="QGroupBox" name="groupFormat">
        <property name="minimumSize"><size><width>0</width><height>100</height></size></property>
        <property name="title"><string>Format</string></property>
        <layout class="QGridLayout">
         <item row="0" column="0"><widget class="QLabel"><property name="text"><string>Tracks:</string></property></widget></item>
         <item row="0" column="1"><widget class="QSpinBox" name="spinTracks"><property name="maximum"><number>255</number></property><property name="value"><number>80</number></property></widget></item>
         <item row="0" column="2"><widget class="QLabel"><property name="text"><string>Sides:</string></property></widget></item>
         <item row="0" column="3"><widget class="QSpinBox" name="spinSides"><property name="minimum"><number>1</number></property><property name="maximum"><number>2</number></property><property name="value"><number>1</number></property></widget></item>
         <item row="1" column="0"><widget class="QLabel"><property name="text"><string>Sectors:</string></property></widget></item>
         <item row="1" column="1"><widget class="QSpinBox" name="spinSectors"><property name="minimum"><number>1</number></property><property name="maximum"><number>36</number></property><property name="value"><number>11</number></property></widget></item>
         <item row="1" column="2"><widget class="QLabel"><property name="text"><string>Size:</string></property></widget></item>
         <item row="1" column="3"><widget class="QComboBox" name="comboSectorSize">
          <item><property name="text"><string>256</string></property></item>
          <item><property name="text"><string>512</string></property></item>
         </widget></item>
         <item row="2" column="0"><widget class="QLabel"><property name="text"><string>Encoding:</string></property></widget></item>
         <item row="2" column="1"><widget class="QComboBox" name="comboEncoding">
          <item><property name="text"><string>MFM</string></property></item>
          <item><property name="text"><string>FM</string></property></item>
          <item><property name="text"><string>GCR</string></property></item>
         </widget></item>
         <item row="2" column="2"><widget class="QLabel"><property name="text"><string>RPM:</string></property></widget></item>
         <item row="2" column="3"><widget class="QComboBox" name="comboRPM">
          <item><property name="text"><string>300</string></property></item>
          <item><property name="text"><string>360</string></property></item>
         </widget></item>
        </layout>
       </widget>
      </item>
      
      <!-- KOPIERPLAN (MF-1233) -->
      <!--
        Vier Achsen statt eines Modus. Die Wertelisten stehen hier
        ABSICHTLICH nicht: sie kommen aus uft_copy_level_name() und
        seinen drei Geschwistern, also aus derselben Quelle, die der
        Kern benutzt. Eine zweite Liste im .ui waere genau der Fehler,
        den comboXCopyMode gegen comboCopyMode vorfuehrt - zwei Listen,
        zwei Wahrheiten.
      -->
      <item>
       <widget class="QGroupBox" name="groupCopyPlan">
        <property name="title"><string>Kopierplan</string></property>
        <layout class="QVBoxLayout">
         <!--
           Der Einstieg (MF-1237): ein benannter Kopiermodus statt vier
           Achsen. Vier Achsen ergeben 360 Plaene - vollstaendig, aber
           kein Einstieg. Ein Bediener denkt in „RawCopy", nicht in
           „bitstream/standard/layout/verify".

           Das Profil SETZT die vier Achsen darunter und sperrt sie.
           Wer eine anfasst, arbeitet danach ohne Profil weiter; die
           Achsen bleiben dabei sichtbar, damit man sieht, WAS das
           Profil eingestellt hat.

           Die Liste kommt aus uft_copy_profile() - eine Tafel fuer
           Kern und Oberflaeche.
         -->
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>Kopiermodus:</string></property></widget></item>
           <item><widget class="QComboBox" name="comboCopyProfile"/></item>
           <item><widget class="QPushButton" name="btnPlanAnpassen">
            <property name="text"><string>Plan anpassen</string></property>
           </widget></item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="labelProfileText">
           <property name="wordWrap"><bool>true</bool></property>
           <property name="text"><string/></property>
          </widget>
         </item>
         <!--
           MF-1238: was das Format TRAEGT.

           Bis hierher sagte die Oberflaeche nur, was NICHT geht
           (labelPlanFindings). Diese Zeile ist die andere Haelfte - und
           sie unterscheidet drei Zustaende, nicht zwei: traegt,
           traegt nicht, und „nicht feststellbar". Das Dritte ist der
           ehrliche Fall fuer VIER Flaggen - Bitstrom, Dateisystem,
           Commodore-BAM und GCR (gemessen: copyPlanCaps() setzt genau
           diese vier nie, die Bauabsicht nannte irrtuemlich drei): dieser
           Reiter kennt kein geoeffnetes Abbild und kann sie nicht
           messen. Sie als „traegt nicht" zu fuehren waere eine Messung
           behaupten, die es nicht gibt.

           Die Namen kommen aus uft_copy_cap_name() - eine Tafel.
         -->
         <item>
          <widget class="QLabel" name="labelPlanCaps">
           <property name="wordWrap"><bool>true</bool></property>
           <property name="text"><string/></property>
          </widget>
         </item>
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>Ebene:</string></property></widget></item>
           <item><widget class="QComboBox" name="comboPlanLevel"/></item>
           <item><widget class="QLabel"><property name="text"><string>Strategie:</string></property></widget></item>
           <item><widget class="QComboBox" name="comboPlanStrategy"/></item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>Erhaltung:</string></property></widget></item>
           <item><widget class="QComboBox" name="comboPlanPreserve"/></item>
           <item><widget class="QLabel"><property name="text"><string>Sicherheit:</string></property></widget></item>
           <item><widget class="QComboBox" name="comboPlanPolicy"/></item>
          </layout>
         </item>
         <!--
           Die Feinheiten (MF-1235). Jede steht in einem eigenen
           Zeilen-Widget, damit Beschriftung UND Auswahlfeld zusammen
           verschwinden, sobald sie unter der aktuellen Wahl nichts
           bedeuten. Ausgegraut waere hier falsch: ein gesperrtes
           „Commodore GCR" auf der Sektorebene sagt „spaeter
           vielleicht" — es bedeutet dort aber gar nichts.

           Die Wertelisten stehen auch hier ABSICHTLICH nicht im .ui:
           sie kommen aus uft_copy_track_mode_name() und seinen vier
           Geschwistern.
         -->
         <item>
          <layout class="QHBoxLayout">
           <item>
            <widget class="QWidget" name="rowPlanTrackMode">
             <layout class="QHBoxLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <item><widget class="QLabel"><property name="text"><string>Spurart:</string></property></widget></item>
              <item><widget class="QComboBox" name="comboPlanTrackMode"/></item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowPlanFileSpecial">
             <layout class="QHBoxLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <item><widget class="QLabel"><property name="text"><string>Dateiart:</string></property></widget></item>
              <item><widget class="QComboBox" name="comboPlanFileSpecial"/></item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowPlanGcr">
             <layout class="QHBoxLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <item><widget class="QLabel"><property name="text"><string>GCR-Verfahren:</string></property></widget></item>
              <item><widget class="QComboBox" name="comboPlanGcr"/></item>
             </layout>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <layout class="QHBoxLayout">
           <item>
            <widget class="QWidget" name="rowPlanVote">
             <layout class="QHBoxLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <item><widget class="QLabel"><property name="text"><string>Abstimmung:</string></property></widget></item>
              <item><widget class="QComboBox" name="comboPlanVote"/></item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowPlanExact">
             <layout class="QHBoxLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <item><widget class="QLabel"><property name="text"><string>Genauigkeit:</string></property></widget></item>
              <item><widget class="QComboBox" name="comboPlanExact"/></item>
             </layout>
            </widget>
           </item>
           <item>
            <widget class="QWidget" name="rowPlanHash">
             <layout class="QHBoxLayout">
              <property name="leftMargin"><number>0</number></property>
              <property name="rightMargin"><number>0</number></property>
              <item><widget class="QLabel"><property name="text"><string>Hash:</string></property></widget></item>
              <!-- SHA-256 ist Pflicht: gesetzt und gesperrt. Sichtbar
                   bleibt es trotzdem, damit der Bediener sieht, WAS
                   gerechnet wird. -->
              <item><widget class="QCheckBox" name="checkHashSha256">
               <property name="text"><string>SHA-256</string></property>
               <property name="checked"><bool>true</bool></property>
               <property name="enabled"><bool>false</bool></property>
              </widget></item>
              <item><widget class="QCheckBox" name="checkHashSha512">
               <property name="text"><string>SHA-512</string></property>
              </widget></item>
              <item><widget class="QCheckBox" name="checkHashCrc32">
               <property name="text"><string>CRC32</string></property>
              </widget></item>
             </layout>
            </widget>
           </item>
          </layout>
         </item>
         <item>
          <widget class="QLabel" name="labelPlanFindings">
           <property name="wordWrap"><bool>true</bool></property>
           <property name="text"><string/></property>
          </widget>
         </item>
         <item>
          <widget class="QLabel" name="labelPlanForced">
           <property name="wordWrap"><bool>true</bool></property>
           <property name="text"><string/></property>
          </widget>
         </item>
         <!--
           MF-1238: der Plan als JSON.

           uft_copy_plan_to_json() gibt es seit MF-1234 und es hatte
           null Aufrufer - eine fertige Tuer ohne Weg dorthin, die
           Klasse MF-930. Die Ansicht ist versteckt, bis jemand sie
           aufklappt: sie ist die Kontrollform, nicht die Bedienform.

           Der Text wird NICHT hier erzeugt. Er kommt Zeichen fuer
           Zeichen aus dem Kern, und die Laenge wird beim Kern erfragt,
           statt einen festen Puffer zu waehlen.
         -->
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QPushButton" name="btnPlanJson">
            <property name="checkable"><bool>true</bool></property>
            <property name="text"><string>Plan als JSON zeigen</string></property>
           </widget></item>
           <item><widget class="QPushButton" name="btnPlanJsonKopieren">
            <property name="text"><string>In die Zwischenablage</string></property>
           </widget></item>
           <item><widget class="QPushButton" name="btnPlanJsonSichern">
            <property name="text"><string>Sichern …</string></property>
           </widget></item>
           <item><spacer name="spacerPlanJson">
            <property name="orientation"><enum>Qt::Horizontal</enum></property>
            <property name="sizeHint"><size><width>40</width><height>20</height></size></property>
           </spacer></item>
          </layout>
         </item>
         <item>
          <widget class="QPlainTextEdit" name="textPlanJson">
           <property name="visible"><bool>false</bool></property>
           <property name="readOnly"><bool>true</bool></property>
           <property name="minimumSize"><size><width>0</width><height>160</height></size></property>
          </widget>
         </item>
        </layout>
       </widget>
      </item>

      <!-- XCOPY -->
      <item>
       <widget class="QGroupBox" name="groupXCopy">
        <property name="minimumSize"><size><width>0</width><height>100</height></size></property>
        <property name="title"><string>XCopy</string></property>
        <layout class="QVBoxLayout">
         <item>
          <layout class="QHBoxLayout">
           <item><widget class="QLabel"><property name="text"><string>Start:</string></property></widget></item>
           <item><widget class="QSpinBox" name="spinStartTrack"><property name="maximum"><number>255</number></property></widget></item>
           <item><widget class="QLabel"><property name="text"><string>End:</string></property></widget></item>
